{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the settings and note windows",
  "windows": ["settings", "note-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "claude://*" }]
    },
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
